# Biofy.TR environment template.
# The web installer writes the real .env for you; you normally never edit this by hand.
# Never commit or upload a .env that contains real passwords to a public place.

APP_NAME="Biofy.TR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://biofy.tr

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

# Sessions are stored in the database so users can see and end their sessions.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# No worker process is needed on shared hosting.
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# E-mail is configured from the admin panel (Settings -> E-mail). These are fallbacks only.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Behind Cloudflare or a load balancer: TRUSTED_PROXIES=* (or a comma separated list)
TRUSTED_PROXIES=

# Ed25519 public key that verifies signed release manifests (set by the release package).
BIOFY_RELEASE_PUBLIC_KEY=
